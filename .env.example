# ─────────────────────────────────────────────────────────────────────────────
# MediPulse — environment template
# Copy to `.env` for the backend and `frontend/.env.local` for the frontend.
# NEVER commit real `.env` files or service-account keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase web client (frontend/.env.local) ────────────────────────────────
# These are app identifiers, not secrets. Real protection comes from Auth +
# firestore.rules (see docs/firebase-setup.md).
# If omitted, the values baked into frontend/src/lib/firebase.ts are used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point the dev proxy at a non-default analysis backend.
# The Vite dev server proxies /api → http://127.0.0.1:5055 by default.
MEDIPULSE_API_URL=http://127.0.0.1:5055

# ── Flask analysis backend ──────────────────────────────────────────────────
PORT=5055
MEDIPULSE_HOST=127.0.0.1
# Comma-separated allow-list. Defaults to the Vite dev origins.
MEDIPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared secret for the API. Leave empty for local development; when set, every
# patient-data endpoint requires an `X-API-Key` header.
MEDIPULSE_API_KEY=
# SQLite mirror location (readings / alerts / movement events).
MEDIPULSE_SQLITE_PATH=backend/medipulse.db
# Optional trained ECG model (joblib artefact exposing predict_proba).
# Unset → the labelled heuristic prototype is used and reported as such.
MEDIPULSE_MODEL_PATH=

# ── Firebase Admin (server-side tooling only — never commit the key) ─────────
# Used by backend/scripts/verify_firebase.py for the integration self-test.
FIREBASE_SERVICE_ACCOUNT=
